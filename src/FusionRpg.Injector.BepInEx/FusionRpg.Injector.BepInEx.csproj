<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FusionRpg.Injector</AssemblyName>
    <RootNamespace>FusionRpg.Injector</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <BepGameDir Condition="'$(BepGameDir)' == '' and '$(GameDir)' != ''">$(GameDir)</BepGameDir>
    <BepGameDir Condition="'$(BepGameDir)' == '' and '$(FUSIONRPG_GAME_DIR)' != ''">$(FUSIONRPG_GAME_DIR)</BepGameDir>
    <BepGameDir Condition="'$(BepGameDir)' == ''">$(MSBuildThisFileDirectory)..\..\..</BepGameDir>
    <GameDir>$(BepGameDir)</GameDir>
    <OutputPath Condition="'$(OutputPath)' == ''">$(BepGameDir)\BepInEx\plugins\FusionRpg\</OutputPath>
    <AssemblyTitle>FusionRpg Injector</AssemblyTitle>
    <Product>FusionRpg</Product>
    <Company>FusionRpg (hobby OSS)</Company>
    <Authors>Lê Tú Hào</Authors>
    <Description>FusionRpg BepInEx 6 IL2CPP host — game-side capture and apply (AGPL hobby project)</Description>
    <Copyright>Copyright (c) 2026 Lê Tú Hào</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.1.2</Version>
    <InformationalVersion>0.1.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameProfile Condition="'$(GameProfile)' == '' and '$(FUSIONRPG_GAME_PROFILE)' != ''">$(FUSIONRPG_GAME_PROFILE)</GameProfile>
    <GameProfile Condition="'$(GameProfile)' == ''">pvzrh-3.8.1</GameProfile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared game logic (host-agnostic). Host entry is Plugin.cs in this project. -->
    <Compile Include="..\FusionRpg.Injector\**\*.cs"
             Exclude="..\FusionRpg.Injector\obj\**;..\FusionRpg.Injector\bin\**;..\FusionRpg.Injector\Bridges\**" />
    <Compile Include="..\FusionRpg.Injector\Bridges\$(GameProfile)\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FusionRpg.Contracts\FusionRpg.Contracts.csproj" />
    <ProjectReference Include="..\FusionRpg.Core\FusionRpg.Core.csproj" />
    <ProjectReference Include="..\FusionRpg.CheatCore\FusionRpg.CheatCore.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="6.0.36" />
    <!-- In-game overlay host (overlayHost=injector). Ships the loader shim only; Chromium is the machine-wide Evergreen runtime. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <!-- tunables-ssot.md §7.2: the injector loads data/tuning/ and injects it (RpgHost.Initialize);
         Core never reads a file. Copied next to the built DLL, same as the game-side plugin itself. -->
    <Content Include="..\..\data\tuning\**\*.json">
      <Link>data\tuning\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepGameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepGameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepGameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepGameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(BepGameDir)\BepInEx\core\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BepGameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepGameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(BepGameDir)\BepInEx\interop\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BepGameDir)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(BepGameDir)\BepInEx\interop\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    The WebView2 package ships WPF/WinForms wrappers, XML docs and arm64/x86 natives. We use only
    Core plus the x64 loader, and everything here lands in the player's game folder, so drop the
    rest rather than shipping ~1.1 MB of unused payload into a modded IL2CPP install.
  -->
  <Target Name="TrimWebView2Payload" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.xml' AND $([System.String]::new('%(Filename)').StartsWith('Microsoft.Web.WebView2'))" />
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' OR '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <!--
    RID-specific natives resist item-group filtering (they are injected late by the SDK), so sweep
    them from the output after the copy. The game is win-x64 only; arm64/x86 loaders would just sit
    in the player's plugin folder looking like something they should worry about.
  -->
  <Target Name="TrimWebView2Natives" AfterTargets="Build">
    <!--
      Flatten the x64 loader next to the managed DLL. publish-player copies the plugin folder with
      a top-level-files-only sweep, so anything under runtimes\ silently misses the player pack and
      the in-game view degrades to "loader not found". Flat also matches where a reader expects it.
    -->
    <ItemGroup>
      <_Wv2X64Loader Include="@(RuntimeTargetsCopyLocalItems)"
                     Condition="'%(Filename)%(Extension)' == 'WebView2Loader.dll' AND $([System.String]::new('%(Identity)').Contains('win-x64'))" />
    </ItemGroup>
    <!-- Sourced from the package, not from $(OutputPath): an incremental build may not re-copy natives. -->
    <Copy SourceFiles="@(_Wv2X64Loader)" DestinationFolder="$(OutputPath)" ContinueOnError="true" />
    <ItemGroup>
      <_Wv2Runtimes Include="$(OutputPath)runtimes\**\*" />
    </ItemGroup>
    <Delete Files="@(_Wv2Runtimes)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutputPath)runtimes" ContinueOnError="true" />
  </Target>
</Project>
