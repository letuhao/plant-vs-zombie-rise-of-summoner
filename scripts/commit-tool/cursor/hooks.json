{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python scripts/commit-tool/cursor/gate_git_commit.py",
        "matcher": "\\bgit(?:\\.exe)?\\b(?:\\s+-c\\s+\\S+|\\s+-\\S+)*\\s+commit\\b|commit-tool[/\\\\]clean_commit\\.py",
        "failClosed": false
      }
    ]
  }
}
