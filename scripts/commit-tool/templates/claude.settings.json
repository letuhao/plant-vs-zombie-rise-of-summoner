{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(gh pr create*)",
      "Bash(gh release create*)"
    ]
  },
  "enabledMcpjsonServers": ["repo-git"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/commit-tool/block_git_write.py\" --stdin-json --format claude"
          }
        ]
      }
    ]
  }
}
