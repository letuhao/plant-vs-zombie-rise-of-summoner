  "gaugePolicy": {
    "pool": "Fill is current / max of that pool. Full is good.",
    "relative": "Bar length is this value versus the actor's own largest sibling in the group. It is not a cap. Never paint it as CAP.",
    "sigmoid": "Bar length is distance toward the soft shoulder (~±250 points). Tooltip must still show points + ≈ pp vs a named reference.",
    "reciprocal": "Bar is a feel spark only. The number is the authority.",
    "ratio": "Fill is the percent after per-mille rendering. Bounded 0–100% because the unit is.",
    "capped": "Fill is value / cap. At cap: CAP marker, warn colour, inspector says the next point does nothing.",
    "none": "No bar. Number + unit only."
  },
