<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FusionRpg.Tools.DemonSpeciesGen</RootNamespace>
    <AssemblyName>DemonSpeciesGen</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core only — SpeciesExpander is a pure function over an already-loaded anchor and three
         tuning files (spec-species-generator.md §2: "call the shipped arithmetic, not reimplement
         it"). This tool opens no database and issues no SQL: it reads data/seed/demons/species/**,
         writes data/generated/demons/**, both plain files, no RpgStore involved. -->
    <ProjectReference Include="..\..\src\FusionRpg.Core\FusionRpg.Core.csproj" />
  </ItemGroup>
</Project>
